{
  "schema_version": "1.0",
  "project": {
    "name": "Genopedia",
    "component": "reference-engine",
    "manifest_version": "2026.09.1"
  },
  "storage": {
    "root": "${GENOPEDIA_DATA_ROOT:-./data/genopedia}",
    "raw": "${root}/raw",
    "normalized": "${root}/normalized",
    "indexes": "${root}/indexes",
    "metadata": "${root}/metadata",
    "benchmarks": "${root}/benchmarks",
    "reports": "${root}/reports"
  },
  "defaults": {
    "checksum": "sha256",
    "download": {"retries": 5, "timeout_seconds": 120, "concurrency": 4},
    "indexing": {"kmer_sizes": [21, 31, 51], "minimizer_sizes": [15, 19, 23], "canonical_kmers": true},
    "validation": {"allow_iupac": true, "require_checksum": true}
  },
  "sources": [
    {
      "id": "ncbi-refseq",
      "name": "NCBI RefSeq",
      "tier": "A",
      "evidence_class": "authoritative",
      "roles": ["primary_reference", "genomic_reference", "transcript_reference", "protein_validation"],
      "molecules": ["DNA", "RNA", "PROTEIN"],
      "provider": {"name": "NCBI", "url": "https://www.ncbi.nlm.nih.gov/refseq/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release_or_taxonomic_subset",
      "data_products": ["genome FASTA", "transcript FASTA", "protein FASTA", "GFF/GTF", "release metadata"],
      "index_fields": ["accession", "organism", "molecule", "taxonomy", "release"],
      "notes": "Primary reference backbone; production builds must pin the release and checksums."
    },
    {
      "id": "insdc",
      "name": "INSDC: GenBank, ENA, and DDBJ",
      "tier": "A",
      "evidence_class": "diversity",
      "roles": ["sequence_universe", "genomic_diversity", "submitted_sequences"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "INSDC", "url": "https://www.insdc.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "selected_accessions_or_provider_subset",
      "data_products": ["nucleotide records", "accession metadata", "taxonomy links"],
      "index_fields": ["accession", "country", "organism", "collection date", "taxonomy"],
      "notes": "Treat the three partners as one collaboration, not independent sequence universes."
    },
    {
      "id": "ncbi-nt",
      "name": "NCBI nt/nucleotide",
      "tier": "A",
      "evidence_class": "broad_reference",
      "roles": ["broad_nucleotide_reference", "sequence_similarity"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI", "url": "https://www.ncbi.nlm.nih.gov/nucleotide/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "release_or_snapshot",
      "data_products": ["nucleotide database", "accession metadata"],
      "index_fields": ["accession", "taxonomy", "sequence", "source database"],
      "notes": "Compatibility/import layer with substantial overlap with RefSeq and INSDC."
    },
    {
      "id": "sequencing-read-archives",
      "name": "NCBI SRA, ENA Reads, and DDBJ DRA",
      "tier": "A",
      "evidence_class": "empirical",
      "roles": ["empirical_error", "read_evidence", "benchmark"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI SRA / ENA / DRA", "url": "https://www.ncbi.nlm.nih.gov/sra"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "metadata_first_selected_project_or_run",
      "data_products": ["raw reads", "run metadata", "platform and library metadata", "alignment links"],
      "index_fields": ["accession", "organism", "platform", "read length", "coverage", "library", "reference"],
      "notes": "Do not mirror the archive; retain a metadata/index layer and download selected runs only."
    },
    {
      "id": "gtdb",
      "name": "GTDB",
      "tier": "A",
      "evidence_class": "diversity",
      "roles": ["microbial_reference", "taxonomy", "bacterial_classification", "archaeal_classification"],
      "molecules": ["DNA"],
      "provider": {"name": "GTDB", "url": "https://gtdb.ecogenomic.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release",
      "data_products": ["genome FASTA", "taxonomy TSV", "metadata TSV"],
      "index_fields": ["genome", "taxonomy", "species cluster", "release"],
      "notes": "Use as a microbial neighborhood/reference-selection layer."
    },
    {
      "id": "rnacentral",
      "name": "RNAcentral",
      "tier": "A",
      "evidence_class": "diversity",
      "roles": ["noncoding_rna", "rna_reference", "rna_similarity"],
      "molecules": ["RNA"],
      "provider": {"name": "RNAcentral", "url": "https://rnacentral.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release_or_selected_accessions",
      "data_products": ["ncRNA FASTA", "metadata TSV/JSON", "cross-references"],
      "index_fields": ["RNAcentral ID", "RNA class", "taxonomy", "source database"],
      "notes": "Central non-coding RNA resolver; preserve source cross-references."
    },
    {
      "id": "rfam",
      "name": "Rfam",
      "tier": "A",
      "evidence_class": "functional",
      "roles": ["rna_family", "rna_conservation", "structural_evidence"],
      "molecules": ["RNA"],
      "provider": {"name": "Rfam", "url": "https://rfam.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release",
      "data_products": ["seed alignments", "full alignments", "family models", "RNA FASTA"],
      "index_fields": ["family accession", "family name", "taxonomy", "alignment"],
      "notes": "Family and structural evidence should remain distinct from sequence identity."
    },
    {
      "id": "silva",
      "name": "SILVA rRNA",
      "tier": "A",
      "evidence_class": "specialized",
      "roles": ["rrna", "microbial_reference", "taxonomic_classification"],
      "molecules": ["RNA"],
      "provider": {"name": "SILVA", "url": "https://www.arb-silva.de/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release_and_collection_subset",
      "data_products": ["SSU FASTA", "LSU FASTA", "taxonomy", "alignment"],
      "index_fields": ["locus", "taxonomy", "collection", "release"],
      "notes": "Dedicated 16S/18S/LSU evidence layer for rRNA screening and classification."
    },
    {
      "id": "gencode",
      "name": "GENCODE",
      "tier": "A",
      "evidence_class": "authoritative",
      "roles": ["human_reference", "mouse_reference", "transcript_annotation"],
      "molecules": ["DNA", "RNA", "PROTEIN"],
      "provider": {"name": "GENCODE", "url": "https://www.gencodegenes.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "assembly_and_annotation_release_tuple",
      "data_products": ["genome FASTA", "GTF/GFF3", "transcript FASTA", "CDS FASTA", "protein FASTA"],
      "index_fields": ["assembly", "gene", "transcript", "annotation release"],
      "notes": "Never detach annotation version from its assembly."
    },
    {
      "id": "mane",
      "name": "MANE Select and MANE Plus Clinical",
      "tier": "A",
      "evidence_class": "authoritative",
      "roles": ["canonical_transcript", "human_reference", "clinical_transcript_reference"],
      "molecules": ["DNA", "RNA", "PROTEIN"],
      "provider": {"name": "NCBI / EMBL-EBI", "url": "https://www.ncbi.nlm.nih.gov/refseq/MANE/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release",
      "data_products": ["matched transcript records", "gene and transcript mappings"],
      "index_fields": ["gene", "transcript", "assembly", "MANE version"],
      "notes": "Use for cross-database canonical transcript validation, not independent diagnosis."
    },
    {
      "id": "hprc",
      "name": "Human Pangenome Reference Consortium",
      "tier": "B",
      "evidence_class": "diversity",
      "roles": ["human_reference", "pangenome", "reference_bias_reduction"],
      "molecules": ["DNA"],
      "provider": {"name": "HPRC", "url": "https://humanpangenome.org/data/"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "metadata_first_authorized_assemblies_or_reads",
      "data_products": ["haplotype assemblies", "pangenome graphs", "raw sequencing metadata"],
      "index_fields": ["sample", "haplotype", "assembly", "technology", "region"],
      "notes": "Use to test reference bias; access terms vary by linked resource."
    },
    {
      "id": "t2t-chm13",
      "name": "T2T-CHM13",
      "tier": "B",
      "evidence_class": "authoritative",
      "roles": ["human_reference", "difficult_regions", "truth_reference"],
      "molecules": ["DNA"],
      "provider": {"name": "Telomere-to-Telomere Consortium", "url": "https://github.com/marbl/CHM13"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_assembly_release",
      "data_products": ["near-complete human assembly", "assembly metadata", "analysis resources"],
      "index_fields": ["assembly", "chromosome", "region", "release"],
      "notes": "Important for centromeres, telomeres, repeats, and other difficult mapping regions."
    },
    {
      "id": "mirbase",
      "name": "miRBase",
      "tier": "B",
      "evidence_class": "specialized",
      "roles": ["mirna", "small_rna", "rna_reference"],
      "molecules": ["RNA"],
      "provider": {"name": "miRBase", "url": "https://www.mirbase.org/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release",
      "data_products": ["hairpin precursor FASTA", "mature miRNA FASTA", "annotations"],
      "index_fields": ["miRNA accession", "species", "family", "release"],
      "notes": "Keep release metadata because miRNA annotations evolve."
    },
    {
      "id": "uniprot-reference-proteomes",
      "name": "UniProt Reference Proteomes",
      "tier": "B",
      "evidence_class": "functional",
      "roles": ["protein_validation", "coding_sequence_validation"],
      "molecules": ["PROTEIN"],
      "provider": {"name": "UniProt", "url": "https://www.uniprot.org/proteomes/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_release_and_proteome_subset",
      "data_products": ["reference proteome FASTA", "protein metadata", "genome/CDS mappings"],
      "index_fields": ["protein", "organism", "proteome", "gene", "mapping"],
      "notes": "Indirect coding-sequence evidence; a protein match is not proof of a DNA error."
    },
    {
      "id": "giab",
      "name": "Genome in a Bottle / NIST",
      "tier": "B",
      "evidence_class": "ground_truth",
      "roles": ["benchmark", "truth_reference", "variant_validation"],
      "molecules": ["DNA"],
      "provider": {"name": "NIST", "url": "https://www.nist.gov/programs-projects/genome-bottle"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_sample_and_benchmark_release",
      "data_products": ["truth VCF", "high-confidence BED", "structural variation", "benchmark reads"],
      "index_fields": ["sample", "assembly", "variant type", "confidence region", "technology"],
      "notes": "Orthogonal truth evidence for scoring correction and variant workflows."
    },
    {
      "id": "precision-fda",
      "name": "PrecisionFDA challenge datasets",
      "tier": "B",
      "evidence_class": "ground_truth",
      "roles": ["benchmark", "variant_validation", "algorithm_comparison"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "FDA Precision Medicine", "url": "https://precision.fda.gov/challenges/"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "selected_challenge_release",
      "data_products": ["challenge inputs", "truth sets", "evaluation metadata"],
      "index_fields": ["challenge", "sample", "variant class", "evaluation metric"],
      "notes": "Use only the challenge release and terms recorded in the local lockfile."
    },
    {
      "id": "univec",
      "name": "NCBI UniVec and UniVec_Core",
      "tier": "B",
      "evidence_class": "contamination",
      "roles": ["contamination_screen", "adapter_screen", "vector_screen"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI", "url": "https://www.ncbi.nlm.nih.gov/tools/vecscreen/univec/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "pinned_collection_release",
      "data_products": ["vector FASTA", "adapter and contaminant sequences"],
      "index_fields": ["sequence", "contaminant class", "accession", "release"],
      "notes": "Screen contamination before treating an observed difference as biological."
    },
    {
      "id": "rna-seq-controls",
      "name": "ERCC and RNA-seq control collections",
      "tier": "C",
      "evidence_class": "ground_truth",
      "roles": ["benchmark", "empirical_error", "rna_quality_control"],
      "molecules": ["RNA"],
      "provider": {"name": "ERCC RNA controls", "url": "https://www.thermofisher.com/ercc"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "selected_control_protocol_and_dataset",
      "data_products": ["synthetic RNA controls", "expected abundance metadata", "RNA-seq reads"],
      "index_fields": ["control", "transcript", "expected abundance", "platform"],
      "notes": "Useful for RNA-seq error, abundance, and pipeline regression tests."
    },
    {
      "id": "long-read-benchmarks",
      "name": "PacBio HiFi and Oxford Nanopore benchmark collections",
      "tier": "C",
      "evidence_class": "ground_truth",
      "roles": ["benchmark", "empirical_error", "long_read_correction"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI SRA / ENA project records", "url": "https://www.ncbi.nlm.nih.gov/sra"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "curated_run_manifest_with_platform_metadata",
      "data_products": ["raw long reads", "truth reference", "platform metadata", "known variants"],
      "index_fields": ["run", "platform", "chemistry", "read length", "coverage", "truth set"],
      "notes": "Keep Illumina, HiFi, CLR, ONT, RNA, and mixed-platform error profiles separate."
    },
    {
      "id": "metagenomic-benchmarks",
      "name": "Metagenomic mock-community benchmarks",
      "tier": "C",
      "evidence_class": "ground_truth",
      "roles": ["benchmark", "taxonomy_validation", "contamination_screen"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI SRA / ENA project records", "url": "https://www.ebi.ac.uk/ena/browser/home"},
      "access": {"mode": "mixed", "redistribution": "follow_provider_terms"},
      "acquisition": "curated_mock_community_accessions",
      "data_products": ["mock-community reads", "known composition", "reference genomes"],
      "index_fields": ["sample", "organism", "abundance", "platform", "composition"],
      "notes": "Use for taxonomy/reference selection and contamination false-positive tests."
    },
    {
      "id": "viral-and-plasmid-references",
      "name": "Viral and plasmid reference collections",
      "tier": "C",
      "evidence_class": "specialized",
      "roles": ["viral_reference", "plasmid_reference", "contamination_screen"],
      "molecules": ["DNA", "RNA"],
      "provider": {"name": "NCBI RefSeq and INSDC", "url": "https://www.ncbi.nlm.nih.gov/refseq/"},
      "access": {"mode": "public", "redistribution": "follow_provider_terms"},
      "acquisition": "selected_taxonomic_or_plasmid_subset",
      "data_products": ["viral FASTA", "plasmid FASTA", "taxonomy and accession metadata"],
      "index_fields": ["accession", "host", "taxonomy", "replicon", "release"],
      "notes": "Separate foreign-sequence screening from biological variant interpretation."
    }
  ],
  "profiles": {
    "minimal": ["ncbi-refseq", "ncbi-nt", "sequencing-read-archives", "univec"],
    "rna": ["ncbi-refseq", "rnacentral", "rfam", "silva", "mirbase", "rna-seq-controls"],
    "human": ["ncbi-refseq", "gencode", "mane", "hprc", "t2t-chm13", "giab"],
    "microbial": ["ncbi-refseq", "insdc", "gtdb", "silva", "metagenomic-benchmarks"]
  }
}
