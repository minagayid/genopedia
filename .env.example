# Local Docker Compose defaults only. Change these credentials before any shared deployment.
APP_ENV=development
SECURE_COOKIES=false
SESSION_TTL_SECONDS=604800
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=genopedia
POSTGRES_USER=genopedia
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgresql+psycopg://genopedia:local-dev-only-change-me@db:5432/genopedia
